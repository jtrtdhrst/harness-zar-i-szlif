[Unit]
Description=Publish reviewed Paperclip MCP main commits to the existing Coolify Compose service
After=docker.service network-online.target paperclip-github-app-refresh.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
NoNewPrivileges=true
ExecStart=/usr/bin/python3 /usr/local/libexec/paperclip-mcp-auto-release.py
TimeoutStartSec=500
