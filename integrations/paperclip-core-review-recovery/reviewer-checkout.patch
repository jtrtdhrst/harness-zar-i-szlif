@@ -0,0 +1,538 @@
+import { randomUUID } from "node:crypto";
+import express from "express";
+import request from "supertest";
+import { and, eq, sql } from "drizzle-orm";
+import { afterAll, afterEach, beforeAll, beforeEach, describe, expect, it } from "vitest";
+import {
+  agentWakeupRequests,
+  agents,
+  authUsers,
+  companies,
+  createDb,
+  heartbeatRuns,
+  issueExecutionDecisions,
+  issueRelations,
+  issues,
+} from "@paperclipai/db";
+import {
+  registerServerAdapter,
+  unregisterServerAdapter,
+} from "../adapters/index.js";
+import { errorHandler } from "../middleware/index.js";
+import { issueRoutes } from "../routes/issues.js";
+import { heartbeatService } from "../services/heartbeat.js";
+import { issueService } from "../services/issues.js";
+import {
+  getEmbeddedPostgresTestSupport,
+  startEmbeddedPostgresTestDatabase,
+} from "./helpers/embedded-postgres.js";
+
+const embeddedPostgresSupport = await getEmbeddedPostgresTestSupport();
+const describeEmbeddedPostgres = embeddedPostgresSupport.supported ? describe : describe.skip;
+
+if (!embeddedPostgresSupport.supported) {
+  console.warn(
+    `Skipping H03 false-progress/rework regression on this host: ${embeddedPostgresSupport.reason ?? "unsupported environment"}`,
+  );
+}
+
+const adapterType = "h03_rework_test";
+
+describeEmbeddedPostgres("H03 false-progress rework dispatch", () => {
+  let db!: ReturnType<typeof createDb>;
+  let heartbeat: ReturnType<typeof heartbeatService>;
+  let temporary: Awaited<ReturnType<typeof startEmbeddedPostgresTestDatabase>> | null = null;
+
+  const previousInWorktree = process.env.PAPERCLIP_IN_WORKTREE;
+
+  let releaseExecution: () => void = () => undefined;
+  let executionGate: Promise<void> = Promise.resolve();
+
+  beforeEach(() => {
+    executionGate = new Promise<void>((resolve) => { releaseExecution = resolve; });
+  });
+
+  beforeAll(async () => {
+    // The route builds its own heartbeat service from process.env. Preview
+    // worktrees suppress run execution by default; this suite needs the real
+    // dispatch path so it can observe the issue-bound executor run.
+    delete process.env.PAPERCLIP_IN_WORKTREE;
+    temporary = await startEmbeddedPostgresTestDatabase("paperclip-h03-rework-");
+    db = createDb(temporary.connectionString);
+    heartbeat = heartbeatService(db, { runtimeEnv: {} });
+    registerServerAdapter({
+      type: adapterType,
+      supportsLocalAgentJwt: false,
+      execute: async () => {
+        await executionGate;
+        return {
+          exitCode: 0,
+          signal: null,
+          timedOut: false,
+          sessionId: randomUUID(),
+          resultJson: {},
+        };
+      },
+      testEnvironment: async () => ({
+        adapterType,
+        status: "pass",
+        checks: [],
+        testedAt: new Date().toISOString(),
+      }),
+    });
+  }, 30_000);
+
+  afterEach(async () => {
+    releaseExecution();
+    await heartbeat.drainActiveRunExecutions().catch(() => undefined);
+    // Every test uses a fresh company/issue UUID inside this disposable DB.
+    // Heartbeat work can materialize company-skills rows; deleting the parent
+    // company while queued work is still finalizing creates FK violations.
+    // The embedded test database is removed in afterAll.
+  });
+
+  afterAll(async () => {
+    await heartbeat?.drainActiveRunExecutions().catch(() => undefined);
+    unregisterServerAdapter(adapterType);
+    if (previousInWorktree === undefined) delete process.env.PAPERCLIP_IN_WORKTREE;
+    else process.env.PAPERCLIP_IN_WORKTREE = previousInWorktree;
+    await temporary?.cleanup();
+  });
+
+  const responsibleUserIdByCompany = new Map<string, string>();
+
+  async function seedCompany(prefix: string) {
+    const companyId = randomUUID();
+    const executorAgentId = randomUUID();
+    const reviewerAgentId = randomUUID();
+    const peerAgentId = randomUUID();
+    responsibleUserIdByCompany.set(companyId, `${prefix.toLowerCase()}-owner`);
+    await db.insert(authUsers).values({
+      id: `${prefix.toLowerCase()}-owner`,
+      name: `${prefix} Owner`,
+      email: `${prefix.toLowerCase()}-owner@example.test`,
+      createdAt: new Date(),
+      updatedAt: new Date(),
+    });
+    await db.insert(companies).values({
+      id: companyId,
+      name: `${prefix} Company`,
+      issuePrefix: prefix,
+      requireBoardApprovalForNewAgents: false,
+    });
+    await db.insert(agents).values([
+      {
+        id: executorAgentId,
+        companyId,
+        name: `${prefix} Executor`,
+        role: "engineer",
+        status: "idle",
+        adapterType,
+        adapterConfig: {},
+        runtimeConfig: {},
+        permissions: {},
+      },
+      {
+        id: reviewerAgentId,
+        companyId,
+        name: `${prefix} Reviewer`,
+        role: "engineer",
+        status: "idle",
+        adapterType,
+        adapterConfig: {},
+        runtimeConfig: {},
+        permissions: {},
+      },
+      {
+        id: peerAgentId,
+        companyId,
+        name: `${prefix} Peer`,
+        role: "engineer",
+        status: "idle",
+        adapterType,
+        adapterConfig: {},
+        runtimeConfig: {},
+        permissions: {},
+      },
+    ]);
+    return { companyId, executorAgentId, reviewerAgentId, peerAgentId };
+  }
+
+  async function seedIssue(input: {
+    companyId: string;
+    identifier: string;
+    status: string;
+    assigneeAgentId: string;
+    executionPolicy?: Record<string, unknown> | null;
+    executionState?: Record<string, unknown> | null;
+  }) {
+    const issueId = randomUUID();
+    await db.insert(issues).values({
+      id: issueId,
+      companyId: input.companyId,
+      identifier: input.identifier,
+      title: input.identifier,
+      status: input.status,
+      priority: "medium",
+      assigneeAgentId: input.assigneeAgentId,
+      responsibleUserId: responsibleUserIdByCompany.get(input.companyId) ?? null,
+      issueNumber: null,
+      executionPolicy: input.executionPolicy ?? null,
+      executionState: input.executionState ?? null,
+    });
+    return issueId;
+  }
+
+  async function seedRun(input: {
+    companyId: string;
+    agentId: string;
+    issueId: string;
+    status?: string;
+  }) {
+    const runId = randomUUID();
+    await db.insert(heartbeatRuns).values({
+      id: runId,
+      companyId: input.companyId,
+      agentId: input.agentId,
+      invocationSource: "assignment",
+      triggerDetail: "system",
+      status: input.status ?? "running",
+      contextSnapshot: { issueId: input.issueId, wakeReason: "issue_assigned" },
+    });
+    return runId;
+  }
+
+  function agentActor(companyId: string, agentId: string, runId: string) {
+    return {
+      type: "agent",
+      source: "agent_key",
+      companyId,
+      agentId,
+      runId,
+    };
+  }
+
+  function app(actor: Record<string, unknown>) {
+    const testApp = express();
+    testApp.use(express.json());
+    testApp.use((req, _res, next) => {
+      (req as any).actor = actor;
+      next();
+    });
+    testApp.use("/api", issueRoutes(db, {} as any));
+    testApp.use(errorHandler);
+    return testApp;
+  }
+
+  function patchIssue(input: {
+    actor: Record<string, unknown>;
+    issueId: string;
+    body: Record<string, unknown>;
+  }) {
+    return request(app(input.actor))
+      .patch(`/api/issues/${input.issueId}`)
+      .send(input.body);
+  }
+
+  function waitFor<T>(fn: () => Promise<T | null | undefined>, timeoutMs = 15_000) {
+    const started = Date.now();
+    return (async () => {
+      for (;;) {
+        const value = await fn();
+        if (value) return value;
+        if (Date.now() - started > timeoutMs) {
+          throw new Error("Timed out waiting for expected native state");
+        }
+        await new Promise((resolve) => setTimeout(resolve, 100));
+      }
+    })();
+  }
+
+  it("keeps the DONE blocker edge while excluding it from unresolved eligibility", async () => {
+    const seeded = await seedCompany("DONE");
+    const blockerId = await seedIssue({
+      companyId: seeded.companyId,
+      identifier: "DONE-1",
+      status: "done",
+      assigneeAgentId: seeded.executorAgentId,
+    });
+    const dependentId = await seedIssue({
+      companyId: seeded.companyId,
+      identifier: "DONE-2",
+      status: "todo",
+      assigneeAgentId: seeded.executorAgentId,
+    });
+    await db.insert(issueRelations).values({
+      companyId: seeded.companyId,
+      issueId: blockerId,
+      relatedIssueId: dependentId,
+      type: "blocks",
+    });
+
+    const svc = issueService(db);
+    const readiness = await svc.getDependencyReadiness(dependentId);
+    expect(readiness.blockerIssueIds).toEqual([blockerId]);
+    expect(readiness.unresolvedBlockerIssueIds).toEqual([]);
+    expect(readiness.isDependencyReady).toBe(true);
+
+    const checkoutRunId = await seedRun({
+      companyId: seeded.companyId,
+      agentId: seeded.executorAgentId,
+      issueId: dependentId,
+      status: "queued",
+    });
+    const checkedOut = await svc.checkout(
+      dependentId,
+      seeded.executorAgentId,
+      ["todo"],
+      checkoutRunId,
+    );
+    expect(checkedOut?.status).toBe("in_progress");
+
+    const [edge] = await db
+      .select({ id: issueRelations.id })
+      .from(issueRelations)
+      .where(eq(issueRelations.relatedIssueId, dependentId));
+    expect(edge?.id).toBeTruthy();
+  });
+
+  it("still denies cancelled and unresolved blocker relations (negative control)", async () => {
+    const seeded = await seedCompany("NEG");
+    const svc = issueService(db);
+
+    for (const [index, blockerStatus] of ["cancelled", "in_progress", "blocked"].entries()) {
+      const blockerId = await seedIssue({
+        companyId: seeded.companyId,
+        identifier: `NEG-B${index}`,
+        status: blockerStatus,
+        assigneeAgentId: seeded.executorAgentId,
+      });
+      const dependentId = await seedIssue({
+        companyId: seeded.companyId,
+        identifier: `NEG-D${index}`,
+        status: "todo",
+        assigneeAgentId: seeded.executorAgentId,
+      });
+      await db.insert(issueRelations).values({
+        companyId: seeded.companyId,
+        issueId: blockerId,
+        relatedIssueId: dependentId,
+        type: "blocks",
+      });
+
+      const readiness = await svc.getDependencyReadiness(dependentId);
+      expect(readiness.isDependencyReady).toBe(false);
+      expect(readiness.unresolvedBlockerIssueIds).toContain(blockerId);
+      await expect(
+        svc.checkout(dependentId, seeded.executorAgentId, ["todo", "blocked"], randomUUID()),
+      ).rejects.toMatchObject({ status: 422 });
+    }
+  });
+
+  it("dispatches a real issue-bound executor run on changes_requested and persists both decisions", async () => {
+    const seeded = await seedCompany("RWK");
+    const stageId = randomUUID();
+    const issueId = await seedIssue({
+      companyId: seeded.companyId,
+      identifier: "RWK-1",
+      status: "in_review",
+      assigneeAgentId: seeded.reviewerAgentId,
+      executionPolicy: {
+        mode: "normal",
+        commentRequired: true,
+        stages: [
+          {
+            id: stageId,
+            type: "review",
+            approvalsNeeded: 1,
+            participants: [{ id: randomUUID(), type: "agent", agentId: seeded.reviewerAgentId }],
+          },
+        ],
+      },
+      executionState: {
+        status: "pending",
+        currentStageId: stageId,
+        currentStageIndex: 0,
+        currentStageType: "review",
+        currentParticipant: { type: "agent", agentId: seeded.reviewerAgentId },
+        returnAssignee: { type: "agent", agentId: seeded.executorAgentId },
+        reviewRequest: null,
+        completedStageIds: [],
+        lastDecisionId: null,
+        lastDecisionOutcome: null,
+        changesRequestedCount: 0,
+      },
+    });
+    const reviewerRunId = await seedRun({
+      companyId: seeded.companyId,
+      agentId: seeded.reviewerAgentId,
+      issueId,
+    });
+    const changes = await patchIssue({
+      actor: agentActor(seeded.companyId, seeded.reviewerAgentId, reviewerRunId),
+      issueId,
+      body: { status: "in_progress", comment: "Needs another pass." },
+    });
+    expect(changes.status, JSON.stringify(changes.body)).toBe(200);
+    expect(changes.body).toMatchObject({
+      id: issueId,
+      status: "in_progress",
+      assigneeAgentId: seeded.executorAgentId,
+      executionState: {
+        status: "changes_requested",
+        currentStageId: stageId,
+        lastDecisionOutcome: "changes_requested",
+        returnAssignee: { type: "agent", agentId: seeded.executorAgentId },
+      },
+    });
+
+    const [changesDecision] = await db
+      .select()
+      .from(issueExecutionDecisions)
+      .where(
+        and(
+          eq(issueExecutionDecisions.issueId, issueId),
+          eq(issueExecutionDecisions.outcome, "changes_requested"),
+        ),
+      );
+    expect(changesDecision).toMatchObject({
+      stageId,
+      actorAgentId: seeded.reviewerAgentId,
+      body: "Needs another pass.",
+    });
+
+    const wake = await waitFor(async () => {
+      const [row] = await db
+        .select()
+        .from(agentWakeupRequests)
+        .where(
+          and(
+            eq(agentWakeupRequests.agentId, seeded.executorAgentId),
+            eq(agentWakeupRequests.reason, "execution_changes_requested"),
+            sql`${agentWakeupRequests.payload}->>'issueId' = ${issueId}`,
+          ),
+        );
+      return row ?? null;
+    });
+    expect(wake.payload).toMatchObject({ issueId, mutation: "update" });
+
+    const executorRun = await waitFor(async () => {
+      const [row] = await db
+        .select()
+        .from(heartbeatRuns)
+        .where(
+          and(
+            eq(heartbeatRuns.agentId, seeded.executorAgentId),
+            sql`${heartbeatRuns.contextSnapshot}->>'issueId' = ${issueId}`,
+          ),
+        );
+      return row ?? null;
+    });
+    expect(executorRun.id).toBeTruthy();
+    expect(["queued", "running"]).toContain(executorRun.status);
+    expect(executorRun.wakeupRequestId).toBe(wake.id);
+
+    // The executor's issue-bound run can adopt the unowned checkout and resubmit.
+    const resubmit = await patchIssue({
+      actor: agentActor(seeded.companyId, seeded.executorAgentId, executorRun.id),
+      issueId,
+      body: { status: "in_review", comment: "Addressed the review feedback." },
+    });
+    expect(resubmit.status, JSON.stringify(resubmit.body)).toBe(200);
+    expect(resubmit.body).toMatchObject({
+      id: issueId,
+      status: "in_review",
+      assigneeAgentId: seeded.reviewerAgentId,
+      executionState: {
+        status: "pending",
+        currentStageId: stageId,
+        currentParticipant: { type: "agent", agentId: seeded.reviewerAgentId },
+        returnAssignee: { type: "agent", agentId: seeded.executorAgentId },
+      },
+    });
+
+    const reviewerApprovalRunId = await seedRun({
+      companyId: seeded.companyId,
+      agentId: seeded.reviewerAgentId,
+      issueId,
+    });
+    const approved = await patchIssue({
+      actor: agentActor(seeded.companyId, seeded.reviewerAgentId, reviewerApprovalRunId),
+      issueId,
+      body: { status: "done", comment: "Approved after rework." },
+    });
+    expect(approved.status, JSON.stringify(approved.body)).toBe(200);
+    expect(approved.body).toMatchObject({ id: issueId, status: "done" });
+
+    const decisions = await db
+      .select()
+      .from(issueExecutionDecisions)
+      .where(eq(issueExecutionDecisions.issueId, issueId))
+      .orderBy(issueExecutionDecisions.createdAt, issueExecutionDecisions.id);
+    expect(decisions.map((decision) => decision.outcome)).toEqual([
+      "changes_requested",
+      "approved",
+    ]);
+    expect(decisions[1]).toMatchObject({
+      actorAgentId: seeded.reviewerAgentId,
+      body: "Approved after rework.",
+    });
+
+    await heartbeat.cancelRun(executorRun.id, "test cleanup").catch(() => undefined);
+    releaseExecution();
+  }, 60_000);
+
+  it("rejects a non-participant advancing the review stage (negative control)", async () => {
+    const seeded = await seedCompany("AUTH");
+    const stageId = randomUUID();
+    const issueId = await seedIssue({
+      companyId: seeded.companyId,
+      identifier: "AUTH-1",
+      status: "in_review",
+      assigneeAgentId: seeded.reviewerAgentId,
+      executionPolicy: {
+        mode: "normal",
+        commentRequired: true,
+        stages: [
+          {
+            id: stageId,
+            type: "review",
+            approvalsNeeded: 1,
+            participants: [{ id: randomUUID(), type: "agent", agentId: seeded.reviewerAgentId }],
+          },
+        ],
+      },
+      executionState: {
+        status: "pending",
+        currentStageId: stageId,
+        currentStageIndex: 0,
+        currentStageType: "review",
+        currentParticipant: { type: "agent", agentId: seeded.reviewerAgentId },
+        returnAssignee: { type: "agent", agentId: seeded.executorAgentId },
+        reviewRequest: null,
+        completedStageIds: [],
+        lastDecisionId: null,
+        lastDecisionOutcome: null,
+        changesRequestedCount: 0,
+      },
+    });
+    const peerRunId = await seedRun({
+      companyId: seeded.companyId,
+      agentId: seeded.peerAgentId,
+      issueId,
+    });
+
+    const res = await patchIssue({
+      actor: agentActor(seeded.companyId, seeded.peerAgentId, peerRunId),
+      issueId,
+      body: { status: "in_progress", comment: "Not my review." },
+    });
+    expect(res.status).toBe(422);
+    expect(res.body.error).toContain("Only the active reviewer");
+    const decisions = await db
+      .select()
+      .from(issueExecutionDecisions)
+      .where(eq(issueExecutionDecisions.issueId, issueId));
+    expect(decisions).toEqual([]);
+  });
+});
