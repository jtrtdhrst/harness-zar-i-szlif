+/**
+ * A resolved legacy recovery record must normally retain a no-replay hold.
+ * Exception: the original worker was definitively cancelled BEFORE runtime
+ * selection or provider dispatch during an owner-to-independent-review handoff.
+ * Never use this for an active recovery, a running/dispatched provider, a
+ * cancelled issue, or a change of assignee outside the formal review state.
+ *
+ * The caller additionally checks for any non-lifecycle run event before
+ * suppressing the read-only blocker projection. No recovery/audit row is
+ * deleted or rewritten, and review approval remains mandatory.
+ */
+export function safeUndispatchedReviewHandoff(input: {
+  actionStatus: string;
+  actionCause: string;
+  noReplayMarker: unknown;
+  issueStatus: string | undefined;
+  currentAssigneeAgentId: string | null | undefined;
+  sourceIssueId: string;
+  run: {
+    agentId: string;
+    status: string;
+    errorCode: string | null;
+    scopeKind: string | null;
+    contextSnapshot: Record<string, unknown> | null;
+    runtimeModeResolvedAt: Date | null;
+    processPid: number | null;
+    processGroupId: number | null;
+    processStartedAt: Date | null;
+    externalRunId: string | null;
+    runnerInstanceId: string | null;
+    nativeSessionId: string | null;
+    driverKind: string | null;
+    logBytes: number | bigint | null;
+    resultJson: Record<string, unknown> | null;
+  } | null | undefined;
+}): boolean {
+  const { run } = input;
+  return Boolean(
+    input.actionStatus === "resolved" &&
+    input.actionCause === "legacy_execution_requires_reconciliation" &&
+    input.noReplayMarker === "blocked" &&
+    input.issueStatus === "in_review" &&
+    input.currentAssigneeAgentId &&
+    run &&
+    input.currentAssigneeAgentId !== run.agentId &&
+    run.status === "cancelled" &&
+    run.errorCode === "issue_reassigned" &&
+    run.scopeKind === "issue" &&
+    run.contextSnapshot?.issueId === input.sourceIssueId &&
+    run.resultJson?.reassignmentStopConfirmed === true &&
+    run.runtimeModeResolvedAt === null &&
+    run.processPid === null &&
+    run.processGroupId === null &&
+    run.processStartedAt === null &&
+    run.externalRunId === null &&
+    run.runnerInstanceId === null &&
+    run.nativeSessionId === null &&
+    run.driverKind === null &&
+    (run.logBytes === null || Number(run.logBytes) === 0)
+  );
+}
