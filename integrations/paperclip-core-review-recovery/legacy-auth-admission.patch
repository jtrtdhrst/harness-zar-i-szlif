+it("does not invent uncertain provider work from a confirmed Hermes create-run auth denial", () => {
+  const failed = {
+    runtimeMode: "legacy", status: "failed", errorCode: "hermes_gateway_auth_failed",
+    scheduledRetryReason: "transient_failure", scheduledRetryAttempt: 8,
+    resultJson: { connectionFailure: {
+      schemaVersion: 1, provider: "hermes_gateway",
+      operation: "create_run", reason: "authentication_failed",
+    } },
+  };
+  expect(legacyExecutionNeedsReconciliation(failed)).toBe(false);
+  expect(legacyExecutionNeedsReconciliation({ ...failed, scheduledRetryAttempt: 0 })).toBe(false);
+
+  // An exact provider-created run or post-create denial is not proof of
+  // no dispatch. Keep all such cases on the conservative recovery path.
+  for (const resultJson of [
+    {},
+    { connectionFailure: { ...failed.resultJson.connectionFailure, operation: "get_run" } },
+    { connectionFailure: { ...failed.resultJson.connectionFailure, reason: "connection_timeout" } },
+    { connectionFailure: { ...failed.resultJson.connectionFailure, schemaVersion: 2 } },
+    { connectionFailure: { ...failed.resultJson.connectionFailure, provider: "other" } },
+    { connectionFailure: failed.resultJson.connectionFailure, run_id: "remote-started" },
+    { connectionFailure: failed.resultJson.connectionFailure,
+      executionRecovery: { kind: "running", providerWorkStarted: true } },
+  ]) {
+    expect(legacyExecutionNeedsReconciliation({ ...failed, resultJson })).toBe(true);
+  }
+  expect(legacyExecutionNeedsReconciliation({ ...failed, status: "timed_out" })).toBe(true);
+  expect(legacyExecutionNeedsReconciliation({ ...failed, status: "cancelled" })).toBe(true);
+  expect(legacyExecutionNeedsReconciliation({ ...failed, errorCode: "process_lost" })).toBe(true);
+});
