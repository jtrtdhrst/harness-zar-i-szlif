 type Run = typeof heartbeatRuns.$inferSelect;
 export const LEGACY_RECOVERY_CAUSE = "legacy_execution_requires_reconciliation";
+
+/**
+ * Explicit Hermes create-run auth rejection has no remote run to reconcile.
+ * Timeouts, transport failures and any post-create error remain uncertain.
+ */
+function confirmedHermesCreateAuthDenial(
+  run: Pick<Run, "runtimeMode" | "status" | "errorCode" | "resultJson">,
+): boolean {
+  const evidence = run.resultJson?.connectionFailure as Record<string, unknown> | undefined;
+  return Boolean(
+    run.runtimeMode === "legacy" &&
+    run.status === "failed" &&
+    run.errorCode === "hermes_gateway_auth_failed" &&
+    evidence?.schemaVersion === 1 &&
+    evidence.provider === "hermes_gateway" &&
+    evidence.operation === "create_run" &&
+    evidence.reason === "authentication_failed" &&
+    !run.resultJson?.run_id &&
+    !run.resultJson?.externalRunId &&
+    !run.resultJson?.executionRecovery
+  );
+}
 
