+async function loadPaperclipRoleInstructions(ctx: AdapterExecutionContext): Promise<string> {
+  const filePath = nonEmpty(ctx.config.instructionsFilePath);
+  if (!filePath) return "";
+  const rootPath = nonEmpty(ctx.config.instructionsRootPath);
+  if (!rootPath) throw new Error("Paperclip role bundle has no approved instructionsRootPath.");
+  if (!isAbsolute(rootPath) || !isAbsolute(filePath)) throw new Error("Paperclip role bundle path must be absolute.");
+  const [rootReal, fileReal] = await Promise.all([realpath(rootPath), realpath(filePath)]);
+  const inside = relative(rootReal, fileReal);
+  if (!inside || inside.startsWith("..") || isAbsolute(inside) || inside.split(sep).includes("..")) {
+    throw new Error("Paperclip role instructions path escapes its assigned bundle root.");
+  }
+  const st = await stat(fileReal);
+  if (!st.isFile() || st.size <= 0 || st.size > 150_000) {
+    throw new Error("Paperclip role instructions must be a nonempty, bounded file.");
+  }
+  const body = await readFile(fileReal, "utf8");
+  if (!body.trim()) throw new Error("Paperclip role instructions are empty.");
+  return body;
