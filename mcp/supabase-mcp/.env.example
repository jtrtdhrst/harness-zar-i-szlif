# Self-hosted Supabase MCP
#
# The MCP server talks to the Supabase stack through the Kong gateway
# (http://kong:8000) and to Postgres directly (postgresql://...).
SUPABASE_URL=http://kong:8000
DATABASE_URL=postgresql://postgres:changeme@db:5432/postgres
# Optional: PostgREST / analytics URL, when not derived from SUPABASE_URL.
POSTGREST_URL=
# Optional: bearer token for the Supabase management API.
SUPABASE_ACCESS_TOKEN=
# Optional: JWT secret used to verify Authorization: Bearer tokens in HTTP mode.
SUPABASE_AUTH_JWT_SECRET=
# Typed DDL (add_nullable_column) target allowlist. Comma-separated schema names.
# Unset/empty disables the tool; reserved schemas are always refused.
SUPABASE_MCP_DDL_SCHEMA_ALLOWLIST=
