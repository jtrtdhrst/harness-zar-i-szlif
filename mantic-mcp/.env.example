# Mautic 7 API — OAuth2 client-credentials. All four are REQUIRED
# (the server refuses to start without them).
MAUTIC_BASE_URL=https://mautic.example.pl/api/
MAUTIC_CLIENT_ID=
MAUTIC_CLIENT_SECRET=
MAUTIC_TOKEN_ENDPOINT=https://mautic.example.pl/api/oauth/token

# HTTP bridge (Dockerfile.http) only.
BRIDGE_PORT=8090
# Optional shared secret; when set, requests must send `Authorization: Bearer <token>`.
BRIDGE_TOKEN=

# --- Write guard (SECURITY GATE v2) -----------------------------------------
# Every provider-mutating tool is DENIED unless all four values below are
# present and consistent. These are operator policy, not provider credentials;
# the grant carries no secret. Leaving MAUTIC_WRITE_GRANT empty keeps this
# deployment read-only, which is the intended default.
#
# Pinned identity (required for any write). Checked authoritatively against
# MAUTIC_BASE_URL's host and the provider's own GET /users/self answer.
MAUTIC_TARGET_HOST=
MAUTIC_TARGET_TENANT=
MAUTIC_PRINCIPAL=

# Least-privilege TEST-only grant as one JSON object on one line. Only these
# five tools can ever be granted: create_contact, update_contact,
# delete_contact, add_contact_tags, create_tag. Send/activation/enrollment/
# campaign/segment/email/content/project mutations are refused even if listed.
# Shape (no real values belong in this file):
# {"tenant":"<same as MAUTIC_TARGET_TENANT>","tools":["add_contact_tags"],
#  "allowedTagPrefixes":["TEST-"],"allowedContactEmails":["*@example.invalid"],
#  "scope":"test-only","expiresAt":"2030-01-01T00:00:00Z"}
MAUTIC_WRITE_GRANT=

# How long a successful identity check is reused before the provider is asked
# again (milliseconds). Default 60000.
MAUTIC_WRITE_GUARD_IDENTITY_TTL_MS=60000
