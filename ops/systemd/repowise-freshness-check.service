[Unit]
Description=Verify RepoWise checkouts match the last fetched GitHub main
After=repowise-github-sync.service
ConditionPathExists=/opt/repowise-knowledge/repowise_freshness_check.py
# Skip rather than fail when the sync currently holds its lock.
ExecCondition=/usr/bin/flock -n /run/lock/repowise-github-sync.lock /bin/true

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 /opt/repowise-knowledge/repowise_freshness_check.py --max-age 1800
TimeoutStartSec=60
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/repowise-knowledge
ReadOnlyPaths=/etc /usr
StandardOutput=journal
StandardError=journal
