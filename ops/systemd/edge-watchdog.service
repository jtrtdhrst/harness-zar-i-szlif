[Unit]
Description=Restore the public Caddy edge when it stops serving
After=network-online.target docker.service
Requires=docker.service
ConditionPathExists=/usr/local/libexec/edge-watchdog.sh

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/edge-watchdog.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
TimeoutStartSec=60
