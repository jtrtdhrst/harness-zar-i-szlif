# Source-managed copy of the existing host unit.
# This unit is intentionally limited to the two isolated CI Docker sockets.
[Unit]
Description=Bounded image retention for isolated CI Docker daemons
After=zis-actions-rootless-docker.service zis-ci-guest-docker.service

[Service]
Type=oneshot
ExecCondition=/bin/sh -c '! pgrep -x Runner.Worker >/dev/null'
ExecCondition=/bin/sh -c '[ -S /run/zis-rootless-docker/docker.sock ] || [ -S /run/zis-ci-guest/docker.sock ]'
ExecStart=/bin/sh -euc 'for socket in /run/zis-rootless-docker/docker.sock /run/zis-ci-guest/docker.sock; do if [ -S "$socket" ]; then /usr/bin/docker -H "unix://$socket" image prune --all --force --filter until=72h; fi; done'
Nice=15
IOSchedulingClass=idle
