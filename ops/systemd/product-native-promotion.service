[Unit]
Description=Multica native-reviewed product source -> Coolify release
Documentation=https://github.com/jtrtdhrst/harness-zar-i-szlif
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service
ConditionPathExists=/usr/local/libexec/product_native_promotion.py
ConditionPathExists=/usr/local/libexec/multica_native_release_gate.py

[Service]
Environment=PRODUCT_NATIVE_GATE=/usr/local/libexec/multica_native_release_gate.py
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 /usr/local/libexec/product_native_promotion.py
WorkingDirectory=/
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/paperclip-gitops
TimeoutStartSec=1200
UMask=0077
