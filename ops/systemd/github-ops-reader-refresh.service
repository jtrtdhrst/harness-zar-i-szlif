[Unit]
Description=Rotate scoped GitHub App grants for Multica and GitHub Ops MCP
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
TimeoutStartSec=240
Environment=GITHUB_OPS_WRITER_MINT_ENABLED=true
ExecStart=/usr/bin/python3 /usr/local/libexec/multica-zar-github-app-refresh.py
ExecStartPost=/usr/bin/python3 /usr/local/libexec/github-ops-token-project.py
