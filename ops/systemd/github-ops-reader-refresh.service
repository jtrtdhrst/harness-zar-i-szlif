[Unit]
Description=Refresh existing scoped GitHub Ops MCP reader grant
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
TimeoutStartSec=100
ExecStart=/usr/bin/python3 /usr/local/libexec/multica-zar-github-app-refresh.py --github-ops-reader-only
