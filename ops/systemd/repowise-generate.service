[Unit]
Description=Write unwritten RepoWise concept pages with the configured model
After=repowise-github-sync.service

[Service]
Type=oneshot
# The existing generator invokes docker exec against one pinned RepoWise container.
# Docker's root socket is root-equivalent: unit sandboxing limits accidental
# filesystem/network access but does NOT make that socket least-privileged.
# A future narrowed Docker API broker requires separate independent review.
User=root
Group=root
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/run/lock
ExecStart=/usr/bin/flock -n /run/lock/repowise-generate.lock /opt/repowise-knowledge/refill-all.sh
TimeoutStartSec=5400
Nice=10
