[Unit]
Description=Multica Done gate: revert statuses without delivery evidence
Documentation=https://github.com/miloszspyrka-code/harness-zar-i-szlif
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service
ConditionPathExists=/usr/local/libexec/multica_done_gate.py

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 /usr/local/libexec/multica_done_gate.py
WorkingDirectory=/
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/multica-done-gate
TimeoutStartSec=120
UMask=0077
