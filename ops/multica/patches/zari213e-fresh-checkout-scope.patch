+func TestProjectRepoScopeFailClosed(t *testing.T) {
+	harness := "https://github.com/jtrtdhrst/harness-zar-i-szlif.git"
+	product := "https://github.com/jtrtdhrst/zar-i-szlif.git"
+	raw, _ := json.Marshal(map[string]string{"url": harness})
+	task := Task{ProjectID: "harness",
+		ProjectResources: []ProjectResourceData{{ResourceType: "github_repo", ResourceRef: raw}}}
+	repos := projectTaskRepoURLs(task)
+	if len(repos) != 1 || repos[0] != harness {
+		t.Fatalf("repos = %v", repos)
+	}
+	if !repoURLInTaskScope(harness, repos) ||
+		repoURLInTaskScope(product, repos) ||
+		repoURLInTaskScope("https://github.com/miloszspyrka-code/harness-zar-i-szlif.git", repos) ||
+		repoURLInTaskScope("https://github.com@bad.invalid/x/y", repos) {
+		t.Fatal("project repository boundary violated")
+	}
+	task.ProjectID = ""
+	if len(projectTaskRepoURLs(task)) != 0 {
+		t.Fatal("no-project task got repo grant")
+	}
+}
+func TestRepoScopeHandlerBoundToTask(t *testing.T) {
+	d := &Daemon{logger: slog.Default()}
+	d.registerActiveRepoCheckoutTask("synthetic-token", activeRepoCheckoutTask{
+		WorkspaceID: "workspace", TaskID: "task", ProjectID: "harness",
+		AgentID: "agent", AgentName: "Harness",
+		RepoURLs: []string{"https://github.com/jtrtdhrst/harness-zar-i-szlif.git"},
+	})
+	req := httptest.NewRequest(http.MethodGet, "/repo/scope", nil)
+	req.Header.Set("Authorization", "Bearer synthetic-token")
+	rec := httptest.NewRecorder()
+	d.repoScopeHandler().ServeHTTP(rec, req)
+	if rec.Code != http.StatusOK {
+		t.Fatalf("status=%d %s", rec.Code, rec.Body.String())
+	}
+	var scope repoScopeResponse
+	if err := json.Unmarshal(rec.Body.Bytes(), &scope); err != nil ||
+		scope.ProjectID != "harness" || len(scope.RepoURLs) != 1 {
+		t.Fatalf("unexpected scope: %v %+v", err, scope)
+	}
+	req.Header.Del("Authorization")
+	rec = httptest.NewRecorder()
+	d.repoScopeHandler().ServeHTTP(rec, req)
+	if rec.Code != http.StatusUnauthorized {
+		t.Fatalf("unauth status=%d", rec.Code)
+	}
+}
