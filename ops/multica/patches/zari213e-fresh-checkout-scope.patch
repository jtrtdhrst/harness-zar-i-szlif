+func TestCreateWorktreeFreshFailsWhenFetchFails(t *testing.T) {
+	t.Parallel()
+	sourceRepo := createTestRepo(t)
+	cache := New(t.TempDir(), testLogger())
+	if err := cache.Sync("ws-1", []RepoInfo{{URL: sourceRepo}}); err != nil {
+		t.Fatalf("sync failed: %v", err)
+	}
+	if err := os.RemoveAll(sourceRepo); err != nil {
+		t.Fatalf("remove origin: %v", err)
+	}
+
+	params := WorktreeParams{
+		WorkspaceID: "ws-1",
+		RepoURL:     sourceRepo,
+		WorkDir:     t.TempDir(),
+		AgentName:   "QA",
+		TaskID:      "d4e5f6a7-b8c9-0123-def0-234567890123",
+		Fresh:       true,
+	}
+	if _, err := cache.CreateWorktree(params); err == nil ||
+		!strings.Contains(err.Error(), "fresh checkout requires a successful remote fetch") {
+		t.Fatalf("fresh checkout error = %v, want a failed-fetch error", err)
+	}
+}
