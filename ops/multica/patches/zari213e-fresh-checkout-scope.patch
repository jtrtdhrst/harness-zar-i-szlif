+// A disabled OAuth flag from the Multica MCP registry is not a valid Codex
+// McpServerOAuthConfig table. Omit only explicit false; preserve structured
+// OAuth and fail closed on unsupported true rather than silently granting access.
+func isCodexDisabledOAuth(key string, value any) bool {
+	if key != "oauth" {
+		return false
+	}
+	enabled, ok := value.(bool)
+	return ok && !enabled
+}
