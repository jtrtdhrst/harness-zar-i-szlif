+func TestCodexManagedMcpOAuthFalseCompatibility(t *testing.T) {
+	t.Parallel()
+	mcp := json.RawMessage(`{"mcpServers":{"remote":{"type":"http","url":"https://mcp.example.test/session","oauth":false},"local":{"command":"mock","oauth":false}}}`)
+	block, hasServers, err := renderCodexMcpServersBlock(mcp)
+	if err != nil {
+		t.Fatalf("render: %v", err)
+	}
+	if !hasServers || strings.Contains(block, "oauth = false") {
+		t.Fatalf("disabled boolean OAuth must not appear in Codex TOML: %s", block)
+	}
+	for _, table := range []string{"[mcp_servers.remote]", "[mcp_servers.local]"} {
+		if !strings.Contains(block, table) {
+			t.Fatalf("missing authorized server %q", table)
+		}
+	}
+	structured := map[string]any{"scopes": []any{"read"}}
+	preserved := normalizeCodexMcpServerConfig(map[string]any{
+		"type": "http", "url": "https://mcp.example.test/session", "oauth": structured,
+	})
+	if !reflect.DeepEqual(preserved["oauth"], structured) {
+		t.Fatal("structured OAuth must be preserved, never silently disabled")
+	}
+	unsupported := normalizeCodexMcpServerConfig(map[string]any{
+		"type": "http", "url": "https://mcp.example.test/session", "oauth": true,
+	})
+	if unsupported["oauth"] != true {
+		t.Fatal("unsupported true OAuth must remain fail-closed, not silently downgraded")
+	}
+}
