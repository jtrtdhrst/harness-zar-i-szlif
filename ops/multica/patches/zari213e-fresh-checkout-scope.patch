+// repoScopeResponse is the trusted, token-bound task scope consumed by the
+// root Git credential broker. It exposes no secret, only the repositories the
+// active task may use.
+type repoScopeResponse struct {
+	WorkspaceID string   `json:"workspace_id"`
+	TaskID      string   `json:"task_id"`
+	ProjectID   string   `json:"project_id"`
+	AgentID     string   `json:"agent_id"`
+	AgentName   string   `json:"agent_name"`
+	RepoURLs    []string `json:"repo_urls"`
+}
+
+// repoScopeHandler lets the local root broker resolve a task token to the
+// same project-scoped repository claim that /repo/checkout enforces. It is
+// bound to the task's bearer token, exactly like /repo/checkout.
+func (d *Daemon) repoScopeHandler() http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodGet {
+			http.Error(w, "method not allowed", http.StatusMethodNotAllowed)
+			return
+		}
+		activeTask, authResult := d.activeRepoCheckoutTask(r)
+		if authResult != repoCheckoutAuthOK {
+			d.writeRepoCheckoutAuthError(w, authResult)
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_ = json.NewEncoder(w).Encode(repoScopeResponse{
+			WorkspaceID: activeTask.WorkspaceID,
+			TaskID:      activeTask.TaskID,
+			ProjectID:   activeTask.ProjectID,
+			AgentID:     activeTask.AgentID,
+			AgentName:   activeTask.AgentName,
+			RepoURLs:    activeTask.RepoURLs,
+		})
+	}
+}
+
+// githubIdentity returns a canonical repository identity only for strict HTTPS
+// GitHub URLs. Redirects and lookalike hosts never imply a grant.
+func githubIdentity(raw string) string {
+	u, err := url.Parse(raw)
+	if err != nil || u.Scheme != "https" || u.Host != "github.com" ||
+		u.User != nil || u.RawQuery != "" || u.Fragment != "" {
+		return ""
+	}
+	path := strings.TrimSuffix(strings.TrimSuffix(u.Path, "/"), ".git")
+	parts := strings.Split(strings.TrimPrefix(path, "/"), "/")
+	if len(parts) != 2 {
+		return ""
+	}
+	for _, part := range parts {
+		if part == "" || part == "." || part == ".." {
+			return ""
+		}
+		for _, c := range part {
+			if !((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+				(c >= '0' && c <= '9') || c == '_' || c == '-' || c == '.') {
+				return ""
+			}
+		}
+	}
+	return strings.ToLower(parts[0] + "/" + parts[1])
+}
+
+// Only task-bound project resources authorize project repository use.
+func projectTaskRepoURLs(task Task) []string {
+	if task.ProjectID == "" {
+		return nil
+	}
+	seen := map[string]bool{}
+	var urls []string
+	for _, resource := range task.ProjectResources {
+		if resource.ResourceType != "github_repo" {
+			continue
+		}
+		var ref struct {
+			URL string `json:"url"`
+		}
+		if json.Unmarshal(resource.ResourceRef, &ref) != nil {
+			continue
+		}
+		id := githubIdentity(ref.URL)
+		if id == "" || seen[id] {
+			continue
+		}
+		seen[id] = true
+		urls = append(urls, ref.URL)
+	}
+	// Project task admission must fail closed on ambiguous repo sets.
+	// Never hand a task a workspace-wide repository allowlist.
+	if len(urls) != 1 {
+		return nil
+	}
+	return urls
+}
+func repoURLInTaskScope(requested string, allowed []string) bool {
+	key := githubIdentity(requested)
+	if key == "" {
+		return false
+	}
+	for _, repo := range allowed {
+		if githubIdentity(repo) == key {
+			return true
+		}
+	}
+	return false
+}
