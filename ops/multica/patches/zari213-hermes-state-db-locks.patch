+// files with a state.db.* prefix as deletable database state.
+func TestHermesStateFamilyClassificationDoesNotMirrorUnrelatedDotNames(t *testing.T) {
+	t.Parallel()
+	for _, name := range []string{"state.db", "state.db-wal", "state.db-shm",
+		"state.db-journal", "state.db.quarantine.lock", "state.db.fts_rebuild.lock"} {
+		if !isHermesTaskLocalStateEntry(name) {
+			t.Errorf("SQLite sidecar %s must be task-local", name)
+		}
+	}
+	for _, name := range []string{"state.db.bak", "state.db.notes",
+		"state.db.quarantine.lock.backup"} {
+		if isHermesTaskLocalStateEntry(name) {
+			t.Errorf("unrelated dot-name %s must not be deleted by migration", name)
+		}
+	}
+}
