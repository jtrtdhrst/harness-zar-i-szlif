+// TestHermesOverlayReuseDetachesLegacySharedLockLinks proves that the existing
+// state marker does not preserve the old shared-profile lock symlinks.
+func TestHermesOverlayReuseDetachesLegacySharedLockLinks(t *testing.T) {
+	t.Parallel()
+	sharedHome := t.TempDir()
+	mustWrite(t, filepath.Join(sharedHome, "config.yaml"), "model: hermes-4\n")
+	lockNames := []string{"state.db.quarantine.lock", "state.db.fts_rebuild.lock"}
+	for _, name := range lockNames {
+		mustWrite(t, filepath.Join(sharedHome, name), "HOST "+name)
+	}
+	hermesHome := filepath.Join(t.TempDir(), "hermes-home")
+	skills := []SkillContextForEnv{{Name: "Review Helper", Content: "x"}}
+	if _, err := prepareHermesHome(hermesHome, sharedHome, false, skills, nil, "", "", testLogger()); err != nil {
+		t.Fatalf("create home: %v", err)
+	}
+	if _, err := os.Stat(filepath.Join(hermesHome, hermesTaskLocalStateMarker)); err != nil {
+		t.Fatalf("marker absent: %v", err)
+	}
+	// Simulate an overlay that was already migrated by an older daemon.
+	for _, name := range lockNames {
+		if err := os.Symlink(filepath.Join(sharedHome, name), filepath.Join(hermesHome, name)); err != nil {
+			t.Skipf("symlink creation unavailable: %v", err)
+		}
+	}
+	if _, err := prepareHermesHome(hermesHome, sharedHome, false, skills, nil, "", "", testLogger()); err != nil {
+		t.Fatalf("reuse home: %v", err)
+	}
+	for _, name := range lockNames {
+		if _, err := os.Lstat(filepath.Join(hermesHome, name)); !os.IsNotExist(err) {
+			t.Errorf("shared lock link %s retained: %v", name, err)
+		}
+		if got, err := os.ReadFile(filepath.Join(sharedHome, name)); err != nil || string(got) != "HOST "+name {
+			t.Errorf("source lock altered %s: %q (%v)", name, got, err)
+		}
+	}
+	// A newly created task-owned regular lock must survive another reuse.
+	mustWrite(t, filepath.Join(hermesHome, lockNames[0]), "TASK LOCK")
+	if _, err := prepareHermesHome(hermesHome, sharedHome, false, skills, nil, "", "", testLogger()); err != nil {
+		t.Fatalf("second reuse: %v", err)
+	}
+	if got, err := os.ReadFile(filepath.Join(hermesHome, lockNames[0])); err != nil || string(got) != "TASK LOCK" {
+		t.Errorf("task lock not preserved: %q (%v)", got, err)
+	}
+}
