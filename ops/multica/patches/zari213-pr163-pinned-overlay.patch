+// scopedRepoClaimKey distinguishes remote repository identity from exact local
+// paths. An unrecognized URL/relative path is never an authorization key.
+func scopedRepoClaimKey(rawURL string) string {
+	trimmed := strings.TrimSpace(rawURL)
+	if trimmed == "" {
+		return ""
+	}
+	if identity := repoIdentity(trimmed); identity != "" {
+		return "repo:" + identity
+	}
+	// Local paths are byte-exact grants; never normalize whitespace into
+	// permission to access a different on-disk path.
+	if rawURL != trimmed {
+		return ""
+	}
+	if filepath.IsAbs(rawURL) && filepath.Clean(rawURL) == rawURL {
+		return "local:" + rawURL
+	}
+	return ""
+}
+
+// taskRepoURLs binds checkout authorization to the project resource manifest
+// supplied by the trusted task claim, not to the workspace fallback. The server
+// intentionally supplies workspace repos to projects without github_repo
+// resources for legacy context; those fallback URLs must never authorize a
+// cross-project checkout. A task without a project keeps workspace semantics.
+func taskRepoURLs(task Task) []string {
+	claimed := make(map[string]string, len(task.Repos))
+	for _, repo := range task.Repos {
+		if key := scopedRepoClaimKey(repo.URL); key != "" {
+			// Safe to trim remote origins; local paths with surrounding
+			// whitespace were rejected by scopedRepoClaimKey.
+			claimed[key] = strings.TrimSpace(repo.URL)
+		}
+	}
+	if task.ProjectID == "" {
+		urls := make([]string, 0, len(claimed))
+		for _, repo := range task.Repos {
+			if url := strings.TrimSpace(repo.URL); url != "" {
+				urls = append(urls, url)
+			}
+		}
+		return urls
+	}
+	urls := make([]string, 0, len(task.ProjectResources))
+	seen := make(map[string]struct{})
+	for _, resource := range task.ProjectResources {
+		if resource.ResourceType != "github_repo" {
+			continue
+		}
+		var ref struct {
+			URL string `json:"url"`
+		}
+		if err := json.Unmarshal(resource.ResourceRef, &ref); err != nil {
+			continue
+		}
+		id := scopedRepoClaimKey(ref.URL)
+		if id == "" {
+			continue
+		}
+		if url, ok := claimed[id]; ok {
+			if _, duplicate := seen[id]; !duplicate {
+				urls = append(urls, url)
+				seen[id] = struct{}{}
+			}
 		}
 	}
 	return urls
