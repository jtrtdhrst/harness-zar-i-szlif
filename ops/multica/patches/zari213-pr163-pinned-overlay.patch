+// TestZARI213ScopeHandlerBrokerContract proves the exact JSON shape consumed
+// by the root Git credential broker for a REAL active task token. A rogue
+// token cannot recover another task's repository grant.
+func TestZARI213ScopeHandlerBrokerContract(t *testing.T) {
+	const token = "zari213-bound-task-token"
+	const harness = "https://github.com/jtrtdhrst/harness-zar-i-szlif.git"
+	d := &Daemon{logger: slog.Default()}
+	d.registerActiveRepoCheckoutTask(token, activeRepoCheckoutTask{
+		WorkspaceID: "ws", TaskID: "task", ProjectID: "harness-project",
+		AgentID: "harness-agent", AgentName: "Harness Engineer",
+		RepoURLs: []string{harness},
+	})
+	own := httptest.NewRequest(http.MethodGet, "/repo/scope", nil)
+	own.Header.Set("Authorization", "Bearer "+token)
+	ownResponse := httptest.NewRecorder()
+	d.repoScopeHandler().ServeHTTP(ownResponse, own)
+	if ownResponse.Code != http.StatusOK {
+		t.Fatalf("own repo scope HTTP %d: %s", ownResponse.Code, ownResponse.Body.String())
+	}
+	var got repoScopeResponse
+	if err := json.Unmarshal(ownResponse.Body.Bytes(), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.WorkspaceID != "ws" || got.TaskID != "task" || got.AgentID != "harness-agent" ||
+		got.ProjectID != "harness-project" || len(got.RepoURLs) != 1 || got.RepoURLs[0] != harness {
+		t.Fatalf("unexpected project-scoped broker contract: %#v", got)
+	}
+	for _, authorization := range []string{"", "Bearer other-task-token"} {
+		denied := httptest.NewRequest(http.MethodGet, "/repo/scope", nil)
+		if authorization != "" {
+			denied.Header.Set("Authorization", authorization)
+		}
+		rec := httptest.NewRecorder()
+		d.repoScopeHandler().ServeHTTP(rec, denied)
+		if rec.Code != http.StatusUnauthorized {
+			t.Fatalf("unbound token unexpectedly revealed scope: HTTP %d", rec.Code)
+		}
+	}
+	wrongMethod := httptest.NewRequest(http.MethodPost, "/repo/scope", nil)
+	wrongMethod.Header.Set("Authorization", "Bearer "+token)
+	rec := httptest.NewRecorder()
+	d.repoScopeHandler().ServeHTTP(rec, wrongMethod)
+	if rec.Code != http.StatusMethodNotAllowed {
+		t.Fatalf("unexpected scope method: HTTP %d", rec.Code)
+	}
+}
