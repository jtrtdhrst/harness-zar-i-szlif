# Reproducible source build: no production token or repository mounted at build.
FROM python:3.12.16-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates git \
    && rm -rf /var/lib/apt/lists/* \
    && python -m pip install --disable-pip-version-check \
      "repowise==0.60.1" "mcp==1.30.0"

RUN groupadd --gid 999 app && useradd --uid 999 --gid 999 --create-home --no-log-init app
WORKDIR /opt
COPY --chown=999:999 deployment_evidence_mcp.py /opt/publisher.py
COPY --chown=999:999 test_deployment_evidence_mcp.py /opt/test_deployment_evidence_mcp.py

# True protocol integration tests run INSIDE the image build on scratch repos.
RUN python -m unittest -v test_deployment_evidence_mcp

USER 999:999
EXPOSE 7339
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
 CMD python -c 'import socket; s=socket.create_connection(("127.0.0.1", int(__import__("os").environ.get("DEPLOY_EVIDENCE_HTTP_PORT", "7339"))), timeout=2); s.close()'
ENTRYPOINT ["python", "/opt/publisher.py", "--http"]
