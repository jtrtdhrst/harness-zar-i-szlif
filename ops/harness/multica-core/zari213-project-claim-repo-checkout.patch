+// A project with no github_repo resource receives a workspace fallback from
+// the upstream claim handler. That fallback is NOT project authorization.
+func TestZARI213ProjectRepoManifestOverridesWorkspaceFallback(t *testing.T) {
+	product := "https://github.com/example/product.git"
+	harness := "https://github.com/example/harness.git"
+	repos := []RepoData{{URL: product}, {URL: harness}}
+	for _, tc := range []struct {
+		name string
+		task Task
+		want []string
+	}{
+		{"harness-resource-only", Task{ProjectID: "harness", Repos: repos, ProjectResources: []ProjectResourceData{
+			{ResourceType: "github_repo", ResourceRef: json.RawMessage(`{"url":"https://github.com/example/harness.git"}`)},
+		}}, []string{harness}},
+		{"zero-resource-project-denies", Task{ProjectID: "security", Repos: repos}, nil},
+		{"invalid-resource-denies", Task{ProjectID: "harness", Repos: repos, ProjectResources: []ProjectResourceData{
+			{ResourceType: "github_repo", ResourceRef: json.RawMessage(`{"url":`)},
+		}}, nil},
+		{"unclaimed-resource-denies", Task{ProjectID: "harness", Repos: []RepoData{{URL: product}}, ProjectResources: []ProjectResourceData{
+			{ResourceType: "github_repo", ResourceRef: json.RawMessage(`{"url":"https://github.com/example/harness.git"}`)},
+		}}, nil},
+		{"exact-local-path-allowed", Task{ProjectID: "harness", Repos: []RepoData{{URL: "/srv/repos/harness"}}, ProjectResources: []ProjectResourceData{
+			{ResourceType: "github_repo", ResourceRef: json.RawMessage(`{"url":"/srv/repos/harness"}`)},
+		}}, []string{"/srv/repos/harness"}},
+		{"different-local-path-denied", Task{ProjectID: "harness", Repos: []RepoData{{URL: "/srv/repos/other"}}, ProjectResources: []ProjectResourceData{
+			{ResourceType: "github_repo", ResourceRef: json.RawMessage(`{"url":"/srv/repos/harness"}`)},
+		}}, nil},
+		{"relative-local-path-denied", Task{ProjectID: "harness", Repos: []RepoData{{URL: "repos/harness"}}, ProjectResources: []ProjectResourceData{
+			{ResourceType: "github_repo", ResourceRef: json.RawMessage(`{"url":"repos/harness"}`)},
+		}}, nil},
+		{"unclean-local-path-denied", Task{ProjectID: "harness", Repos: []RepoData{{URL: "/srv/repos/../harness"}}, ProjectResources: []ProjectResourceData{
+			{ResourceType: "github_repo", ResourceRef: json.RawMessage(`{"url":"/srv/repos/../harness"}`)},
+		}}, nil},
+		{"local-resource-leading-space-denied", Task{ProjectID: "harness", Repos: []RepoData{{URL: "/srv/repos/harness"}}, ProjectResources: []ProjectResourceData{
+			{ResourceType: "github_repo", ResourceRef: json.RawMessage(`{"url":" /srv/repos/harness"}`)},
+		}}, nil},
+		{"local-resource-trailing-space-denied", Task{ProjectID: "harness", Repos: []RepoData{{URL: "/srv/repos/harness"}}, ProjectResources: []ProjectResourceData{
+			{ResourceType: "github_repo", ResourceRef: json.RawMessage(`{"url":"/srv/repos/harness "}`)},
+		}}, nil},
+		{"local-task-trailing-space-denied", Task{ProjectID: "harness", Repos: []RepoData{{URL: "/srv/repos/harness "}}, ProjectResources: []ProjectResourceData{
+			{ResourceType: "github_repo", ResourceRef: json.RawMessage(`{"url":"/srv/repos/harness"}`)},
+		}}, nil},
+		{"workspace-without-project", Task{Repos: repos}, []string{product, harness}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			got := taskRepoURLs(tc.task)
+			if len(got) != len(tc.want) {
+				t.Fatalf("repo URLs: got=%q want=%q", got, tc.want)
+			}
+			for i := range got {
+				if got[i] != tc.want[i] {
+					t.Fatalf("repo[%d] got=%q want=%q", i, got[i], tc.want[i])
+				}
+			}
+		})
+	}
+}
