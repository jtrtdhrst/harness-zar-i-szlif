+// The checkout endpoint must not interpret a path prefix as permission.
+func TestZARI213LocalPathCheckoutExactOnly(t *testing.T) {
+	task := activeRepoCheckoutTask{RepoURLs: []string{"/srv/repos/harness"}}
+	if !taskRepoCheckoutAllowed(task, "/srv/repos/harness") {
+		t.Fatal("exact local checkout denied")
+	}
+	for _, bad := range []string{"/srv/repos/other", "/srv/repos/harness-copy", "/srv/repos/harness/../other", "repos/harness", " /srv/repos/harness", "/srv/repos/harness "} {
+		if taskRepoCheckoutAllowed(task, bad) {
+			t.Fatalf("unexpected local path permission: %q", bad)
+		}
+	}
+}
