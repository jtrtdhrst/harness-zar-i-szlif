#!/usr/bin/env python3
"""Git credential helper backed by the root Multica credential broker."""
import json
import socket
import sys

SOCKET = "/run/multica-git-credential/credential.sock"

# Must match multica-git-credential-broker.py ALLOWED_REPOS.
# The runnable helper cannot import the root-only broker under Landlock.
ALLOWED = {
    "jtrtdhrst/zar-i-szlif",
    "jtrtdhrst/harness-zar-i-szlif",
}


def request(payload):
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    sock.settimeout(130)
    try:
        sock.connect(SOCKET)
        sock.sendall(json.dumps(payload, separators=(",", ":")).encode("utf-8") + b"\n")
        with sock.makefile("rb") as reader:
            line = reader.readline(65536)
    finally:
        sock.close()
    if not line:
        raise ValueError("empty broker response")
    return json.loads(line.decode("utf-8"))


def main():
    if len(sys.argv) < 2 or sys.argv[1] != "get":
        return 0
    fields = {}
    for line in sys.stdin.read().splitlines():
        if "=" in line:
            key, value = line.split("=", 1)
            fields[key] = value
    if fields.get("protocol") != "https" or fields.get("host") != "github.com":
        return 0
    repo = fields.get("path", "").removesuffix(".git").strip("/")
    if repo not in ALLOWED:
        return 0
    try:
        result = request({"op": "credential", "protocol": "https", "host": "github.com", "path": repo})
    except (OSError, ValueError, json.JSONDecodeError) as error:
        print(f"multica git credential: {error}", file=sys.stderr)
        return 0
    if not result.get("ok"):
        print(f"multica git credential: {result.get('error', 'denied')}", file=sys.stderr)
        return 0
    print("username=" + result["username"])
    print("password=" + result["token"])
    return 0


if __name__ == "__main__":
    sys.exit(main())
